<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/appearanceBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Appearance"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Choose how SimbaChat looks on your device."
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/appearanceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/appearanceLight"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:buttonTint="#C9A84C"
                android:padding="12dp"
                android:text="Light Mode"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/appearanceSystem"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:buttonTint="#C9A84C"
                android:padding="12dp"
                android:text="System Default"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/appearanceSaveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#C9A84C"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
