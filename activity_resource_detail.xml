<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Back -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← Resources"
            android:textColor="#C9A84C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Category Hero -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1C1A10"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/categoryIcon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="#141414"
                android:gravity="center"
                android:text="🏛️"
                android:textSize="29sp" />

            <TextView
                android:id="@+id/categoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Government Services"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/categoryDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Official South African government services and information."
                android:textColor="#A0A0A0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/resourceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="4 resources"
                android:textColor="#C9A84C"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="OFFICIAL RESOURCES"
            android:textColor="#C9A84C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Resources Container -->

        <LinearLayout
            android:id="@+id/resourcesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>