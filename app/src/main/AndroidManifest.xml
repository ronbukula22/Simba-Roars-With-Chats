<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimbaChat">

        <!-- Login screen: application launcher -->
        <activity
            android:name=".auth.SignInActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Registration screen -->
        <activity
            android:name=".auth.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main dashboard -->
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false" />


        <activity
            android:name=".auth.ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Existing application screens -->
        <activity
            android:name=".util.ResourceDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".dashboard.Chat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Chat_Room"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.Settings"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".auth.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".util.PrivacySecurityActivity"
            android:exported="false" />

        <activity
            android:name=".util.HelpSupportActivity"
            android:exported="false" />

        <activity
            android:name=".util.AppearanceActivity"
            android:exported="false" />


        <service
            android:name=".notifications.SimbaFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>



    </application>

</manifest>