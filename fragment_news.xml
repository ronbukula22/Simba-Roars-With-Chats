<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News Feed"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stay informed. Stay connected."
            android:textColor="#888888"
            android:textSize="13sp" />


        <!-- BREAKING NEWS -->

        <LinearLayout
            android:id="@+id/breakingBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1C1A10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#C9A84C"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/breakingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BREAKING · Loading latest news..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dismissBreaking"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#C9A84C"
                android:textSize="20sp" />

        </LinearLayout>


        <!-- TAB SWITCHER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="#141414"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/saNewsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/discover_tab_active"
                android:gravity="center"
                android:text="🇿🇦 South Africa"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globalNewsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/discover_tab_inactive"
                android:gravity="center"
                android:text="🌍 Global"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- NEWS LIST -->

        <LinearLayout
            android:id="@+id/newsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ProgressBar
            android:id="@+id/newsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/newsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textColor="#999999"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>